local CoreGui = game:GetService("CoreGui")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

-- Variáveis da Lógica de Time
local TimeAmigo = {} 
local RaioDeSpawn = 60 -- Tamanho da zona de identificação

-- Limpeza de interface antiga
if CoreGui:FindFirstChild("GodHub_Security") then
    CoreGui.GodHub_Security:Destroy()
end

local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "GodHub_Security"
ScreenGui.Parent = CoreGui
ScreenGui.ResetOnSpawn = false
ScreenGui.IgnoreGuiInset = true 

local CoresPadrao = {
    ON = Color3.fromRGB(46, 204, 113),
    OFF = Color3.fromRGB(231, 76, 60),
    Painel = Color3.fromRGB(20, 20, 20),
    Texto = Color3.fromRGB(255, 255, 255),
    BotaoCor = Color3.fromRGB(60, 60, 60),
    Destaque = Color3.fromRGB(255, 215, 0)
}

local ListaCores = {
    Color3.fromRGB(255, 255, 255),
    Color3.fromRGB(46, 204, 113),
    Color3.fromRGB(155, 89, 182)
}
local NomesCores = {"BRANCO", "VERDE", "ROXO"}
local ESP_Index = 1
local FOV_Index = 1
local Aimbot_Ativo = false
local ESP_Ativo = false
local FOV_Raio = 60 

-- ==========================================
-- MECÂNICA DE IDENTIFICAÇÃO DE TIME NO SPAWN
-- ==========================================

local function IdentificarTimeNoSpawn()
    if not Player.Character or not Player.Character:FindFirstChild("HumanoidRootPart") then return end
    
    local MeuPos = Player.Character.HumanoidRootPart.Position
    TimeAmigo = {} -- Limpa qualquer lista anterior
    
    -- Varre os players que estão perto de onde você ACABOU de nascer
    for _, p in pairs(game.Players:GetPlayers()) do
        if p ~= Player and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            local dist = (p.Character.HumanoidRootPart.Position - MeuPos).Magnitude
            if dist <= RaioDeSpawn then
                TimeAmigo[p.UserId] = true -- Identifica como Aliado
            end
        end
    end
end

-- Gatilho de Nascimento e Morte
Player.CharacterAdded:Connect(function(Character)
    -- 1. Quando morre, a lista é limpa automaticamente pelo evento do Humanoid
    local Humanoid = Character:WaitForChild("Humanoid")
    Humanoid.Died:Connect(function()
        TimeAmigo = {} -- A zona "some" quando você morre
    end)

    -- 2. Quando nasce, espera o teleporte inicial do jogo e identifica o time
    task.wait(0.8) 
    IdentificarTimeNoSpawn()
end)

-- Gatilho extra para teleporte (caso o jogo te mova sem você morrer)
local lastPos = Vector3.new(0,0,0)
RunService.Heartbeat:Connect(function()
    if Player.Character and Player.Character:FindFirstChild("HumanoidRootPart") then
        local currentPos = Player.Character.HumanoidRootPart.Position
        if (currentPos - lastPos).Magnitude > 100 then
            task.wait(0.5)
            IdentificarTimeNoSpawn()
        end
        lastPos = currentPos
    end
end)

