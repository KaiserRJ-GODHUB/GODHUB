local Aim_Btn = CriarBotao("AIMBOT: OFF", UDim2.new(0, 15, 0, 105), CoresPadrao.OFF)
local FOV_Color_Btn = CriarBotao("FOV COLOR:\nBRANCO", UDim2.new(0, 145, 0, 105), CoresPadrao.BotaoCor)

-- Lógica de Filtro (Checa se o player é Aliado do Spawn)
local function EhInimigo(p)
    if not p or p == Player or not p.Character then return false end
    if TimeAmigo[p.UserId] then return false end -- Se estava perto no nascimento, ignora
    return true
end

-- Render loop (Aimbot e ESP)
RunService.RenderStepped:Connect(function()
    local centroTela = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    if Aimbot_Ativo then
        local alvo, menorDist = nil, math.huge
        for _, p in pairs(game.Players:GetPlayers()) do
            if EhInimigo(p) and p.Character and p.Character:FindFirstChild("Head") then
                local pos, vis = Camera:WorldToViewportPoint(p.Character.Head.Position)
                if vis then
                    local dist = (Vector2.new(pos.X, pos.Y) - centroTela).Magnitude
                    if dist <= FOV_Raio and dist < menorDist then alvo = p.Character.Head menorDist = dist end
                end
            end
        end
        if alvo then Camera.CFrame = CFrame.new(Camera.CFrame.Position, alvo.Position) end
    end
    if ESP_Ativo then
        for _, p in pairs(game.Players:GetPlayers()) do
            if p ~= Player and p.Character then
                local hl = p.Character:FindFirstChild("ESP_HL")
                if EhInimigo(p) then
                    if not hl then
                        hl = Instance.new("Highlight", p.Character)
                        hl.Name = "ESP_HL"
                        hl.OutlineColor = Color3.new(0, 0, 0)
                        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                    end
                    hl.FillColor = ListaCores[ESP_Index]
                elseif hl then hl:Destroy() end
            end
        end
    end
end)

-- Eventos de Botões
ESP_Btn.MouseButton1Click:Connect(function()
    ESP_Ativo = not ESP_Ativo
    ESP_Btn.Text = ESP_Ativo and "ESP: ON" or "ESP: OFF"
    ESP_Btn.BackgroundColor3 = ESP_Ativo and CoresPadrao.ON or CoresPadrao.OFF
    if not ESP_Ativo then
        for _, p in pairs(game.Players:GetPlayers()) do
            if p.Character and p.Character:FindFirstChild("ESP_HL") then p.Character.ESP_HL:Destroy() end
        end
    end
end)

ESP_Color_Btn.MouseButton1Click:Connect(function()
    ESP_Index = (ESP_Index % #ListaCores) + 1
    ESP_Color_Btn.Text = "ESP COLOR:\n" .. NomesCores[ESP_Index]
end)

Aim_Btn.MouseButton1Click:Connect(function()
    Aimbot_Ativo = not Aimbot_Ativo
    Aim_Btn.Text = Aimbot_Ativo and "AIMBOT: ON" or "AIMBOT: OFF"
    Aim_Btn.BackgroundColor3 = Aimbot_Ativo and CoresPadrao.ON or CoresPadrao.OFF
    FOV_Frame.Visible = Aimbot_Ativo
end)

