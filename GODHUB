-- Lógica de Inimigo
local function EhInimigo(p)
    if not p or p == Player or not p.Character then return false end
    if p.Team ~= nil and Player.Team ~= nil and p.Team == Player.Team then return false end
    local head = p.Character:FindFirstChild("Head")
    if head then
        for _, obj in pairs(head:GetDescendants()) do
            if obj:IsA("TextLabel") and obj.Visible and obj.TextTransparency < 1 then return false end
        end
    end
    return true
end

-- Render loop
RunService.RenderStepped:Connect(function()
    local centroTela = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    if Aimbot_Ativo then
        local alvo, menorDist = nil, math.huge
        for _, p in pairs(game.Players:GetPlayers()) do
            if EhInimigo(p) and p.Character and p.Character:FindFirstChild("Head") then
                local pos, vis = Camera:WorldToViewportPoint(p.Character.Head.Position)
                if vis then
                    local dist = (Vector2.new(pos.X, pos.Y) - centroTela).Magnitude
                    if dist <= FOV_Raio and dist < menorDist then alvo = p.Character.Head menorDist = dist end
                end
            end
        end
        if alvo then Camera.CFrame = CFrame.new(Camera.CFrame.Position, alvo.Position) end
    end
    if ESP_Ativo then
        for _, p in pairs(game.Players:GetPlayers()) do
            if p ~= Player and p.Character then
                local hl = p.Character:FindFirstChild("ESP_HL")
                if EhInimigo(p) then
                    if not hl then
                        hl = Instance.new("Highlight", p.Character)
                        hl.Name = "ESP_HL"
                        hl.OutlineColor = Color3.new(0, 0, 0)
                        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                    end
                    hl.FillColor = ListaCores[ESP_Index]
                elseif hl then hl:Destroy() end
            end
        end
    end
end)

